{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "program",
  "description": "조건맞춤 지원찾기 — 제도 1건. 조건 필드는 원문에 없으면 '확인필요'.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "operator": { "type": "string" },
    "official_url": { "type": "string" },
    "apply_url": { "type": "string" },
    "kinds": { "type": "array", "items": { "enum": ["무료교육", "돈받는교육", "지원금", "응시료", "창업"] }, "minItems": 1 },
    "fields": { "type": "array", "items": { "enum": ["IT·AI", "영상·디자인", "기술·현장", "사무·회계·경영", "외국어", "요리·서비스", "돌봄·보건", "전 분야"] }, "minItems": 1 },
    "regions": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "'전국' 또는 시도명, 시군구 한정이면 '경기 성남시'" },
    "age_min": { "type": ["integer", "null"] },
    "age_max": { "type": ["integer", "null"] },
    "age_unknown": { "type": "boolean", "description": "공고에 나이 제한이 있다고 보이나 숫자를 확인 못 함(예: '청년'만 표기)" },
    "target_groups": { "type": "array", "items": { "enum": ["장애인", "북한 이탈 주민", "제대 군인·보훈", "산재 근로자", "여성", "결혼 이민자·다문화", "자립 준비 청년", "학교 밖 청소년", "농어업인", "기초 생활 수급자·차상위"] }, "description": "이 집단만 신청할 수 있을 때. 우대만 하면 넣지 않음" },
    "education": { "enum": ["제한없음", "고졸이상", "대학재학", "대졸이상", "기타", "확인필요"] },
    "education_note": { "type": "string" },
    "income": { "enum": ["제한없음", "기준있음", "확인필요"] },
    "income_pct_max": { "type": ["integer", "null"], "description": "가구 기준중위소득 % 상한. 기준 없으면 null" },
    "income_note": { "type": "string" },
    "allow_job_seeker": { "enum": ["가능", "불가", "확인필요"] },
    "allow_employed": { "enum": ["가능", "불가", "확인필요"] },
    "allow_business": { "enum": ["가능", "불가", "확인필요"] },
    "allow_student": { "enum": ["가능", "불가", "확인필요"] },
    "other_conditions": { "type": "string" },
    "cost": { "type": "string" },
    "money": { "type": "string" },
    "money_monthly_max_manwon": { "type": ["number", "null"] },
    "format": { "type": "string" },
    "recruit": { "type": "string" },
    "next_deadline": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "summary": { "type": "string" },
    "one_liner": { "type": "string", "maxLength": 28, "description": "목록 카드 한 줄. 숫자·금액·날짜·기관명·지역명 없음. 긴 설명은 summary(상세 페이지)" },
    "duration": {
      "type": "object",
      "description": "교육 기간. 숫자는 quote 안에 글자 그대로 있는 것만. band·text는 tools/merge_card_fields.py가 계산",
      "properties": {
        "kind": { "enum": ["fixed", "range", "varies", "self_paced", "unknown", "not_applicable"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "unit": { "enum": ["시간", "일", "주", "개월", "년", ""] },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "quote": { "type": "string" },
        "source": { "enum": ["official_page", "db_source_quote", "db_text", "none"] },
        "source_url": { "type": "string" },
        "band": { "type": "string", "description": "1주 이내 / 단기(1개월 이내) / 중기(6개월 이내) / 장기, 범위면 '단기~중기', 과정마다 다름, 자유 수강, 빈칸" },
        "text": { "type": "string", "description": "카드 표기용 실제 길이(예: 5~6개월, 140시간)" }
      }
    },
    "schedule": { "enum": ["주간", "야간·주말", "온라인", "혼합", "과정마다 다름", "확인필요", "해당없음"] },
    "cost_type": { "enum": ["무료", "일부 자부담", "확인필요", "해당없음"] },
    "money_short": { "type": "string", "maxLength": 18, "description": "받는 돈 요약. 숫자는 money 원문 표기 그대로" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "properties": { "url": { "type": "string" }, "quote": { "type": "string" } }, "required": ["url", "quote"] }
    },
    "origin": { "enum": ["manual", "api-gov24", "api-youth", "api-hrd"] },
    "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "required": ["id", "name", "operator", "official_url", "kinds", "fields", "regions", "education", "income", "allow_job_seeker", "allow_employed", "allow_business", "allow_student", "cost", "money", "recruit", "summary", "sources", "origin", "checked_at"]
}
